{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MediSlotDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "MediSlot.API",
    "Audience": "MediSlot.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Clinic": {
    "TimeZoneId": "Asia/Kolkata",
    "MaxGenerateDays": 30,
    "CancellationCutoffHours": 2,
    "AutoGenerateDays": 14
  },
  "Jobs": {
    "SlotGenerationCron": "0 1 * * *"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },


    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/medislot-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}